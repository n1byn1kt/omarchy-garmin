#!/usr/bin/env python3
"""garmin-widget — Garmin Connect helper for the io.github.n1byn1kt.garmin Omarchy plugin.

Subcommands: fetch [--week] [--weight] (default) | login | status |
prefs get|set <key> <value> | demo [--weight] (synthetic data, no account,
nothing read or written).

Contract: every subcommand prints exactly one JSON object to stdout and
exits 0. Errors are data: {"ok": false, "error": "<category>"} with
category in: deps | no-tokens | auth-expired | offline | api-error.
"""
import datetime
import json
import os
import random
import stat
import sys
import tempfile
from pathlib import Path

def _home() -> Path:
    return Path(os.environ.get("HOME", str(Path.home())))

# Recomputed at import so tests can swap $HOME per-test via load_helper().
TOKENS_PATH = _home() / ".config" / "garmin-widget" / "tokens.json"
PREFS_PATH = _home() / ".config" / "garmin-widget" / "prefs.json"
CACHE_PATH = _home() / ".cache" / "garmin-widget" / "last.json"
HISTORY_PATH = _home() / ".cache" / "garmin-widget" / "history.json"

HISTORY_DAYS = 7
WEIGHT_DAYS = 30    # weigh-ins are sparse; a week of history would be mostly empty
# One row per day in history.json. Every key is always present, None when no
# source has ever had a value for it, so QML branches on null, not undefined.
HISTORY_FIELDS = (
    "steps", "stepGoal",
    "sleepScore", "sleepMin", "deepMin", "lightMin", "remMin", "awakeMin",
    "restingHr",
    "hrvNight", "hrvWeekly", "hrvBalLow", "hrvBalHigh",
    "bbHigh", "bbLow", "bbCharged", "bbDrained",
    "stressAvg", "stressRestMin", "stressLowMin", "stressMedMin", "stressHighMin",
    "calActive", "calResting",
    "readiness",
)
# 0.2/0.3 wrote these names; they are mapped on load and never written again.
LEGACY_FIELDS = {"bodyBatteryHigh": "bbHigh"}
CURVE_POINTS = 96   # the panel's Canvas is ~300px wide; more is wasted JSON

# Local JSON files are read whole before parsing, so a grown (or planted)
# file is a memory bill the widget pays on every poll. Honest content is
# nowhere near these: a full cache with history runs ~50KB, prefs ~200 bytes.
MAX_CACHE_BYTES = 4 * 1024 * 1024
MAX_PREFS_BYTES = 64 * 1024

STR_CLIP = 80  # display strings taken from the API: label-sized, not data-sized

try:
    import garminconnect  # noqa: F401
    HAS_GARMINCONNECT = True
except Exception:
    HAS_GARMINCONNECT = False

def emit(obj) -> int:
    print(json.dumps(obj))
    return 0


def _clip(v, limit=STR_CLIP):
    """A short display string, or None. API strings get a length budget."""
    return v[:limit] if isinstance(v, str) else None


def _clip_strings(v):
    """Every string anywhere in a JSON value, clipped to the label budget.

    Applied to a re-emitted cache payload: the live fetch clips at the few
    places strings enter, but a cached file is one blob whose every string
    is somebody's choice. No honest value in the payload is longer.
    """
    if isinstance(v, str):
        return v[:STR_CLIP]
    if isinstance(v, dict):
        return {k[:STR_CLIP]: _clip_strings(x) for k, x in v.items()}
    if isinstance(v, list):
        return [_clip_strings(x) for x in v]
    return v


def _open_regular(path: Path, *, directory=False) -> int:
    """An fd for `path`, refusing symlinks and special files.

    Everything under ~/.config and ~/.cache is this user's own, but a
    symlink planted at one of these fixed paths must not redirect a read,
    write or chmod at some other file. O_NOFOLLOW makes a symlink fail the
    open itself (ELOOP); O_NONBLOCK makes a planted fifo open instead of
    blocking forever waiting for a writer, so the fstat can actually reject
    it (and devices) — without it the check is unreachable. From the open
    on, the caller works on the fd, so there is no re-check-the-path race.

    For file opens the immediate parent is opened O_NOFOLLOW too and the
    leaf resolved relative to it (dir_fd): O_NOFOLLOW alone covers only the
    final component, so a symlink planted *at the garmin-widget directory
    itself* would silently redirect every file inside it. Ancestors above
    that (~/.config, ~/.cache) are allowed to be symlinks — pointing those
    at another disk is a legitimate setup this helper did not create.
    """
    base = os.O_NOFOLLOW | os.O_NONBLOCK | os.O_NOCTTY
    if directory:
        fd = os.open(str(path), os.O_RDONLY | os.O_DIRECTORY | base)
    else:
        parent_fd = os.open(str(path.parent), os.O_RDONLY | os.O_DIRECTORY | base)
        try:
            fd = os.open(path.name, os.O_RDONLY | base, dir_fd=parent_fd)
        finally:
            os.close(parent_fd)
    try:
        st = os.fstat(fd)
        ok = stat.S_ISDIR(st.st_mode) if directory else stat.S_ISREG(st.st_mode)
        if not ok:
            raise OSError(f"not a {'directory' if directory else 'regular file'}: {path}")
    except Exception:
        os.close(fd)
        raise
    return fd


def _chmod_guarded(path: Path, mode: int, *, directory=False) -> None:
    try:
        fd = _open_regular(path, directory=directory)
    except PermissionError:
        # A 0000/0200 file can't be opened O_RDONLY, but repairing exactly
        # that is _secure_tokens' job — chmod(2) itself needs no read bit.
        # Fall back to a path chmod behind an lstat type check: a small
        # window reopens between check and chmod, but the alternative is a
        # credential file stuck unreadable forever.
        st = os.lstat(str(path))
        ok = stat.S_ISDIR(st.st_mode) if directory else stat.S_ISREG(st.st_mode)
        if not ok:
            raise OSError(f"not a {'directory' if directory else 'regular file'}: {path}")
        os.chmod(str(path), mode)
        return
    try:
        os.fchmod(fd, mode)
    finally:
        os.close(fd)


def _read_json_guarded(path: Path, cap: int):
    """json.loads of a regular file of sane size; raises on anything else.

    Callers already wrap every local read in try/except and treat failure
    as "no file" — a refused symlink or an oversize file lands in the same
    branch as a torn write.
    """
    with os.fdopen(_open_regular(path), "r") as fh:
        if os.fstat(fh.fileno()).st_size > cap:
            raise OSError(f"file too large: {path}")
        return json.loads(fh.read(cap + 1))

def cmd_status() -> int:
    return emit({"ok": True, "deps": HAS_GARMINCONNECT, "tokens": TOKENS_PATH.exists()})

# Hash-locked: every package, transitive ones included, is pinned by SHA-256
# in requirements.txt, so a tampered PyPI release can't land in the process
# that holds the OAuth refresh token. The plugin path is Omarchy's fixed
# install location for this id.
DEPS_HINT = ("python3 -m venv ~/.local/share/garmin-widget/venv && "
             "~/.local/share/garmin-widget/venv/bin/pip install --require-hashes -r ~/.config/omarchy/plugins/io.github.n1byn1kt.garmin/requirements.txt")

def _venv_python() -> Path:
    return _home() / ".local" / "share" / "garmin-widget" / "venv" / "bin" / "python"

def _trusted_interpreter(path: Path) -> bool:
    """True only if exec'ing `path` can't hand the session to someone else.

    The re-exec below runs whatever sits at that path with this user's
    privileges, so the file has to be unwritable by anyone else and owned by
    someone who already has that power: us, or root. A venv python owned by
    *another* unprivileged account, or one anybody can write to, is an install
    bug at best and a foothold at worst.

    Both the symlink and its target are checked, because `venv/bin/python` is
    normally a symlink chain ending at the root-owned system interpreter — the
    link is ours, the binary is root's, and either one being someone else's is
    the thing worth refusing. Refusing is cheap: the caller falls through to
    the deps payload, which tells the user how to rebuild the venv.
    """
    try:
        link, st = os.lstat(path), os.stat(path)
    except OSError:
        return False
    trusted = (os.geteuid(), 0)
    if link.st_uid not in trusted or st.st_uid not in trusted:
        return False
    return not st.st_mode & 0o022


def _maybe_reexec_into_venv(argv) -> None:
    """Arch (and other PEP 668 distros) block pip into system python.

    If garminconnect isn't importable in the current interpreter but a
    dedicated venv exists, re-exec this same script under the venv's
    python. GARMIN_WIDGET_REEXEC guards against looping if the venv is
    somehow also missing garminconnect.
    """
    if HAS_GARMINCONNECT or "GARMIN_WIDGET_REEXEC" in os.environ:
        return
    venv_py = _venv_python()
    if not _trusted_interpreter(venv_py):
        return
    os.environ["GARMIN_WIDGET_REEXEC"] = "1"
    try:
        os.execv(str(venv_py), [str(venv_py), os.path.abspath(__file__), *argv])
    except OSError:
        # Broken venv (bad perms/shebang, partial install, ENOENT race):
        # fall through to normal dispatch, which will report the deps
        # payload rather than crash before printing any JSON at all.
        pass

def _dispatch(argv) -> int:
    cmd = argv[0] if argv else "fetch"
    if cmd == "status":
        return cmd_status()
    if cmd == "fetch":
        return cmd_fetch(week="--week" in argv[1:], weight="--weight" in argv[1:])
    if cmd == "login":
        return cmd_login()
    if cmd == "prefs":
        return cmd_prefs(argv[1:])
    if cmd == "demo":
        return cmd_demo(weight="--weight" in argv[1:])
    return emit({"ok": False, "error": "api-error", "detail": "unknown-command"})

def main(argv) -> int:
    """Dispatch, and hold the JSON-always/exit-0 contract come what may.

    The bar reads stdout and nothing else. A traceback there — an EOFError
    from a login with no stdin, an AttributeError after a garminconnect
    upgrade — would blank the chip with "unparseable helper output" and give
    the user nothing to act on. Every bug lands here as an api-error instead.

    `demo` never re-execs: it is stdlib only and exists precisely for a box
    that has no venv (and no account) yet, so it must not depend on either.
    """
    if not (argv and argv[0] == "demo"):
        _maybe_reexec_into_venv(argv)
    try:
        return _dispatch(argv)
    except Exception as e:
        return emit({"ok": False, "error": "api-error",
                     "detail": type(e).__name__})

def _get(d, *keys):
    for k in keys:
        d = d.get(k) if isinstance(d, dict) else None
    return d

def _num(v):
    """A real number, or None. Booleans are not numbers here."""
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return None
    return v


def _round(v):
    n = _num(v)
    return None if n is None else round(n)


def _desc_index(descriptors, want):
    """Column index of `want` in one of Garmin's descriptor lists.

    Garmin ships its day series as bare arrays plus a descriptor list naming
    the columns, and the descriptor key/index field names differ per endpoint
    ('key'/'index' for stress, 'bodyBatteryValueDescriptorKey'/...Index for
    body battery). Reading the descriptors rather than hardcoding column 1
    is what keeps this working when a column is added.
    """
    for i, d in enumerate(descriptors or []):
        if not isinstance(d, dict):
            continue
        key = d.get("key", d.get("bodyBatteryValueDescriptorKey"))
        if key == want:
            idx = d.get("index", d.get("bodyBatteryValueDescriptorIndex", i))
            return idx if isinstance(idx, int) else i
    return None


def _downsample(points, limit=CURVE_POINTS):
    """Evenly thin a series to `limit` points, always keeping the last one."""
    n = len(points)
    if n <= limit:
        return points
    step = n / limit
    out = [points[int(i * step)] for i in range(limit)]
    out[-1] = points[-1]
    return out


def _series(rows, descriptors, value_key):
    """[[epochMs, value], ...] from a Garmin day array, or None.

    Rows whose value is missing or negative are dropped: stress uses -1/-2 as
    "no valid reading", and a chart that plots those gets a spike to the floor
    every time the watch was off the wrist.
    """
    if not isinstance(rows, list) or not rows:
        return None
    ti = _desc_index(descriptors, "timestamp")
    vi = _desc_index(descriptors, value_key)
    if ti is None or vi is None:
        return None
    out = []
    for r in rows:
        if not isinstance(r, (list, tuple)) or len(r) <= max(ti, vi):
            continue
        ts, val = _num(r[ti]), _num(r[vi])
        if ts is None or val is None or val < 0:
            continue
        out.append([int(ts), round(val)])
    return _downsample(out) if out else None


def build_curve(body_battery, stress):
    """{"bodyBattery": [...], "stress": [...]} — or None if neither exists.

    The dense minute-level body battery series lives inside get_stress_data
    (401 points on a full day); get_body_battery's own array turned out to be
    a handful of inflection markers (6 points on the same day). Whichever
    source yields more points wins, so the curve is right either way.
    """
    day = body_battery[0] if isinstance(body_battery, list) and body_battery else None
    day = day if isinstance(day, dict) else {}
    stress = stress if isinstance(stress, dict) else {}

    bb_own = _series(day.get("bodyBatteryValuesArray"),
                     day.get("bodyBatteryValueDescriptorDTOList"),
                     "bodyBatteryLevel")
    bb_dense = _series(stress.get("bodyBatteryValuesArray"),
                       stress.get("bodyBatteryValueDescriptorsDTOList"),
                       "bodyBatteryLevel")
    bb = max((s for s in (bb_own, bb_dense) if s), key=len, default=None)
    st = _series(stress.get("stressValuesArray"),
                 stress.get("stressValueDescriptorsDTOList"), "stressLevel")
    if bb is None and st is None:
        return None
    return {"bodyBattery": bb, "stress": st}


def build_hrv(hrv):
    s = _get(hrv, "hrvSummary")
    if not isinstance(s, dict):
        return None
    out = {"lastNightAvg": _round(s.get("lastNightAvg")),
           "weeklyAvg": _round(s.get("weeklyAvg")),
           "status": _clip(s.get("status"))}
    return out if any(v is not None for v in out.values()) else None


def build_readiness(readiness):
    # get_training_readiness returns a list of the day's snapshots, and
    # garminconnect's own typed model says the current one is the entry with
    # the latest timestamp — not index 0, which its morning-readiness helper
    # treats as the wake-up reading. A snapshot can also lack a score. Prefer
    # entries that carry a score, then pick the one with the latest timestamp
    # (ISO strings sort correctly as plain strings); if nothing has a
    # timestamp, settle for the first candidate rather than guessing further.
    r = readiness
    if isinstance(readiness, list) and readiness:
        candidates = [x for x in readiness if isinstance(x, dict)]
        scored = [x for x in candidates if x.get("score") is not None]
        pool = scored or candidates
        stamped = [x for x in pool if x.get("timestamp") or x.get("timestampLocal")]
        if stamped:
            r = max(stamped, key=lambda x: x.get("timestamp") or x.get("timestampLocal") or "")
        elif pool:
            r = pool[0]
        else:
            r = None
    if not isinstance(r, dict):
        return None
    score, level = _round(r.get("score")), _clip(r.get("level"))
    if score is None and level is None:
        return None
    return {"score": score, "level": level}


def build_intensity(intensity):
    if not isinstance(intensity, dict):
        return None
    weekly, goal = _round(intensity.get("weeklyTotal")), _round(intensity.get("weekGoal"))
    if weekly is None and goal is None:
        return None
    return {"weekly": weekly, "goal": goal}


# Fetched once per poll (Q2), replacing get_last_activity() one call for one.
ACTIVITY_LIMIT = 20
# Persisted/returned count — amendment 7 supersedes A3's "truncate to
# ACTIVITY_LIMIT after building": the list a future UI can actually show
# without scrolling is smaller than the fetch page. No list page exists in
# this pass to measure against (Q5), so this is the plan's own draft
# default; see docs/implementation-notes-v5.md.
ACTIVITY_ROWS = 10
ACTIVITY_NAME_CLIP = 48

# typeKey substring families for the detail page's pace-vs-speed choice
# (Q6): pace for anything run/walk/hike-shaped, speed for anything
# cycle/bike-shaped, neither for swim/strength/yoga/etc. Substrings, not a
# full enumeration, so trail_running/indoor_cycling/mountain_biking and
# friends all match their family.
_PACE_TYPE_HINTS = ("run", "walk", "hik")
_SPEED_TYPE_HINTS = ("cycl", "bik")


def _dual(raw, raw_key, built_key):
    """raw[raw_key] if present, else raw[built_key].

    build_activity accepts either a raw Garmin activity dict or its own
    prior output (v0.5 amendment 4: a cached activities list is re-run
    through build_activities on load, to re-enforce the whitelist against a
    hand-edited cache). The two shapes never share a key name, so this is
    enough to make every field below shape-agnostic without a second parser.
    """
    return raw.get(raw_key, raw.get(built_key))


def _activity_id(v):
    """A decimal-string id, 1..2**63-1, or None (v0.5 amendment 6).

    Accepts an int (the raw shape) or an all-digit string (the already-built
    shape, or a real Garmin activitiyId that arrived as a string). Always
    emitted as a string: an id is a label here, not a quantity, and a URL
    built from it must never be Number(id) — re-stringifying int(s) also
    drops any leading zero, which cannot happen for a real id but costs
    nothing to handle correctly.
    """
    n = None
    if isinstance(v, bool):
        n = None
    elif isinstance(v, int):
        n = v
    elif isinstance(v, str) and v.isdigit():
        n = int(v)
    if n is None or not (1 <= n <= 2**63 - 1):
        return None
    return str(n)


def _activity_start(v):
    """YYYY-MM-DDTHH:MM from a Garmin timestamp string, or None.

    Handles both the space-separated ("2026-09-22 07:14:33", what
    startTimeLocal/startTimeGMT actually look like — probed 2026-09-24) and
    T-separated shapes by normalising the separator before slicing. Also
    idempotent on an already-normalised 16-char string (a re-whitelist pass
    over a cached row), and degrades gracefully on a shorter legacy `date`
    field (see _load_cache's legacy migration) rather than padding it.
    """
    if not isinstance(v, str):
        return None
    return _clip(v.replace(" ", "T", 1), 16)


def _activity_pace_speed(type_key, duration_min, distance_km):
    """(paceSecPerKm, speedKmh) — at most one non-None, per Q6.

    Derived from duration/distance rather than the raw averageSpeed field:
    mathematically the same number for a steady effort, and it means this
    still works when build_activity is re-run over an already-built row
    that never carried averageSpeed in the first place (amendment 4).
    """
    if not isinstance(type_key, str) or not duration_min or not distance_km:
        return None, None
    tk = type_key.lower()
    if any(h in tk for h in _PACE_TYPE_HINTS):
        return round(duration_min * 60 / distance_km), None
    if any(h in tk for h in _SPEED_TYPE_HINTS):
        return None, round(distance_km / (duration_min / 60), 1)
    return None, None


def _activity_has_content(raw):
    """A type or a start, in either the raw or already-built spelling —
    otherwise the row is noise (v0.5 A3)."""
    type_key = _get(raw, "activityType", "typeKey") or raw.get("type")
    start = _dual(raw, "startTimeLocal", "start")
    gmt = raw.get("startTimeGMT")
    return bool(type_key) or isinstance(start, str) or isinstance(gmt, str)


def _activity_sort_key(raw):
    """startTimeGMT descending, None-safe (v0.5 amendment 3): missing sorts
    last. Only the raw shape carries startTimeGMT at all — an already-built
    row (a cache re-whitelist pass) has none, so every such row gets the
    same "" key and Python's stable sort leaves them in whatever order they
    were already in, which is the order they were built in."""
    v = raw.get("startTimeGMT")
    return v if isinstance(v, str) else ""


def build_activity(raw, *, activity_names=True):
    """One whitelisted activity row, or None if `raw` isn't a dict.

    Ten fields survive from a raw activity dict that also carries start
    coordinates, activity/device/owner ids, the owner's real name, profile
    image URLs, a location name, a timezone id and split summaries — none
    of that reaches this return value, by omission rather than by naming it
    out. `paceSecPerKm`/`speedKmh` are two more, beyond A2's own ten (Q6) —
    logged in docs/implementation-notes-v5.md since there is no QML detail
    page yet to consume them.

    `date` (bare YYYY-MM-DD) is still emitted alongside `start`
    (YYYY-MM-DDTHH:MM) per amendment 8: the existing card's QML reads
    `lastActivity.date` and is untouched by this pass, so the field it
    reads must keep existing until whichever change makes it read `start`
    instead.
    """
    if not isinstance(raw, dict):
        return None

    activity_id = _activity_id(_dual(raw, "activityId", "id"))

    type_key = _get(raw, "activityType", "typeKey")
    if type_key is None:
        type_key = raw.get("type")
    type_key = _clip(type_key) if isinstance(type_key, str) else None

    name = _dual(raw, "activityName", "name")
    if activity_names and isinstance(name, str) and name.strip():
        name = _clip(name, ACTIVITY_NAME_CLIP)
    else:
        name = None

    start = _activity_start(_dual(raw, "startTimeLocal", "start"))
    date = start[:10] if start else None

    if "duration" in raw:
        duration_min = _minutes(raw.get("duration"))
    else:
        duration_min = _round(raw.get("durationMin"))

    if "distance" in raw:
        n = _num(raw.get("distance"))
        distance_km = round(n / 1000, 2) if n else None
    else:
        n = _num(raw.get("distanceKm"))
        distance_km = round(n, 2) if n is not None else None

    avg_hr = _round(_dual(raw, "averageHR", "avgHr"))
    max_hr = _round(_dual(raw, "maxHR", "maxHr"))
    kcal = _round(_dual(raw, "calories", "kcal"))
    elev_val = raw.get("elevationGain") if "elevationGain" in raw else raw.get("elevM")
    elev_n = _num(elev_val)
    elev_m = _round(elev_n) if elev_n else None

    pace, speed = _activity_pace_speed(type_key, duration_min, distance_km)

    return {
        "id": activity_id,
        "type": type_key,
        "name": name,
        "start": start,
        "date": date,
        "durationMin": duration_min,
        "distanceKm": distance_km,
        "avgHr": avg_hr,
        "maxHr": max_hr,
        "kcal": kcal,
        "elevM": elev_m,
        "paceSecPerKm": pace,
        "speedKmh": speed,
    }


def build_activities(raw, *, activity_names=True):
    """Newest-first (by startTimeGMT), whitelisted, capped at ACTIVITY_ROWS.

    Accepts a bare list or a {"activityList": [...]} dict — the same two
    shapes garminconnect's own get_last_activity handles (A3). Anything
    else is the caller's problem (_fetch_extras treats it as FAILED, per
    amendment 5) — by the time `raw` gets here it is already known-good, or
    this returns [] harmlessly either way. Sliced to ACTIVITY_ROWS *before*
    building, so a hostile 10,000-entry response costs ACTIVITY_ROWS builds,
    not 10,000 (amendment 4's cap test).
    """
    if isinstance(raw, dict):
        raw = raw.get("activityList")
    if not isinstance(raw, list):
        return []
    entries = [r for r in raw if isinstance(r, dict) and _activity_has_content(r)]
    entries.sort(key=_activity_sort_key, reverse=True)
    return [build_activity(r, activity_names=activity_names) for r in entries[:ACTIVITY_ROWS]]


def build_floors(summary):
    count, goal = _round(summary.get("floorsAscended")), _round(
        summary.get("userFloorsAscendedGoal"))
    if count is None and goal is None:
        return None
    return {"count": count, "goal": goal}


def build_calories(summary):
    total, active = _round(summary.get("totalKilocalories")), _round(
        summary.get("activeKilocalories"))
    if total is None and active is None:
        return None
    return {"total": total, "active": active}


# --- weight (v0.5 port of PR #1, @xshatx) ------------------------------------
#
# Ported onto the v0.5 fetch layer rather than merged: the PR was written
# against 0.3.x, before _safe/FAILED, CARRY_KEYS, or the whitelist-rebuild-on-
# load discipline existed. The shape below keeps the PR's field names
# (current/date/startDate/delta/series) and its two-envelope tolerance, but
# adds `unit` and fetches only when the panel actually shows the card (see
# _fetch_extras/cmd_fetch).
_LB_PER_KG = 2.20462


def _to_unit(kg, unit):
    """`kg` converted to the display unit, 1 decimal, or None.

    Kept as one small function (rather than inlining the multiply at each of
    current/delta/series) so a future third unit is one line, not three.
    """
    if kg is None:
        return None
    return round(kg * _LB_PER_KG, 1) if unit == "lb" else round(kg, 1)


def _weight_unit(g):
    """"kg" or "lb", from Garmin's own measurement-system setting.

    garminconnect 0.3.11 loads this at login (Garmin.login() calls
    _load_profile_and_settings(), which sets self.unit_system from
    userData.measurementSystem) — get_unit_system() is a local attribute
    read, not a second network call, so this costs nothing against the
    fetch budget. Anything other than the literal "statute" (an unset
    attribute, "metric", a future value this helper has never seen) falls
    back to kg — the unit build_weight's own math is already done in, so
    "unknown" costs a display label, never a wrong conversion.
    """
    try:
        v = g.get_unit_system()
    except Exception:
        return "kg"
    return "lb" if isinstance(v, str) and v.strip().lower() == "statute" else "kg"


def _kg(v):
    """Garmin weight in kilograms, 1 decimal, or None.

    The weight-service stores grams. A value already in kg is well under
    1000, which is also below any honest adult weigh-in in grams, so that
    is the split. Zero and negative readings are dropped the same way
    stress drops its 'watch off' sentinels.
    """
    n = _num(v)
    if n is None or n <= 0:
        return None
    kg = n / 1000.0 if n >= 1000 else n
    return round(kg, 1)


def _weight_timestamp(row):
    """Epoch milliseconds for one weigh-in, or None."""
    ts = _num(row.get("timestampGMT"))
    if ts is None:
        ts = _num(row.get("date"))
    if ts is not None:
        ts = int(ts)
        return ts if ts > 0 else None
    cal = row.get("calendarDate")
    if not isinstance(cal, str):
        return None
    try:
        d = datetime.date.fromisoformat(cal[:10])
    except ValueError:
        return None
    ts = int(datetime.datetime(d.year, d.month, d.day).timestamp() * 1000)
    return ts if ts > 0 else None


def _weight_rows(raw):
    """Weigh-in dicts from whichever envelope Garmin sent.

    get_weigh_ins (the ranged call) wraps days in dailyWeightSummaries with
    allWeightMetrics; get_body_composition uses a flat dateWeightList. Both
    shapes are accepted so a garminconnect rename of one endpoint still
    yields a card from the other.
    """
    if not isinstance(raw, dict):
        return []
    rows = raw.get("dateWeightList")
    if isinstance(rows, list):
        return [r for r in rows if isinstance(r, dict)]
    summaries = raw.get("dailyWeightSummaries")
    if not isinstance(summaries, list):
        return []
    out = []
    for summary in summaries:
        if not isinstance(summary, dict):
            continue
        metrics = summary.get("allWeightMetrics")
        if isinstance(metrics, list) and metrics:
            out.extend(r for r in metrics if isinstance(r, dict))
            continue
        latest = summary.get("latestWeight")
        if isinstance(latest, dict):
            out.append(latest)
    return out


def build_weight(raw, unit="kg"):
    """{current, date, startDate, delta, series, unit} — or None.

    series is [[epochMs, value], ...] oldest first, downsampled to the same
    96-point cap the day curve uses, values already in the display unit.
    samplePk, sourceType and the rest of the weigh-in dict stay out: they
    are identifiers, not a figure.

    delta is computed in kg (a stable diff regardless of display unit) and
    converted once at the end, so rounding a display-unit delta from two
    already-rounded display-unit values never amplifies the rounding.
    """
    points = []
    seen = set()
    for row in _weight_rows(raw):
        kg, ts = _kg(row.get("weight")), _weight_timestamp(row)
        if kg is None or ts is None:
            continue
        key = (ts, kg)
        if key in seen:
            continue
        seen.add(key)
        cal = row.get("calendarDate")
        date = _clip(cal.split("T")[0].split(" ")[0]) if isinstance(cal, str) else None
        points.append((ts, kg, date))
    if not points:
        return None
    points.sort(key=lambda p: p[0])
    last, prev = points[-1], points[-2] if len(points) > 1 else None
    delta_kg = None if prev is None else round(last[1] - prev[1], 1)
    unit = unit if unit == "lb" else "kg"
    return {
        "current": _to_unit(last[1], unit),
        "date": last[2],
        "startDate": points[0][2],
        "delta": _to_unit(delta_kg, unit),
        "series": [[p[0], _to_unit(p[1], unit)] for p in _downsample(
            [[p[0], p[1]] for p in points])],
        "unit": unit,
    }


def _rebuild_cached_weight(value):
    """Re-applies the weight payload's own whitelist to a cached dict.

    Unlike activities, a cached `weight` value is already in *payload*
    shape (current/date/startDate/delta/series/unit) — there is no raw
    Garmin envelope left to re-parse on load, so amendment 4's protection
    ("whitelist-rebuild on cache load") is applied by rebuilding this exact
    dict field by field instead: only known keys survive, `series` entries
    are re-validated as [epochMs, number] pairs and re-capped, `unit` is
    pinned to a known literal, and the strings go through the same
    _clip_strings pass as every other cached field. A hand-edited (or
    planted) last.json cannot smuggle an extra field or an oversized series
    past a stale-cache serve or a carry-forward this way.
    """
    if not isinstance(value, dict):
        return None
    series = value.get("series")
    clean = []
    if isinstance(series, list):
        for p in series[:CURVE_POINTS * 4]:
            if not isinstance(p, (list, tuple)) or len(p) < 2:
                continue
            t, v = _num(p[0]), _num(p[1])
            if t is None or v is None:
                continue
            clean.append([int(t), v])
    unit = value.get("unit")
    unit = unit if unit in ("kg", "lb") else "kg"
    return {
        "current": _num(value.get("current")),
        "date": _clip(value.get("date")),
        "startDate": _clip(value.get("startDate")),
        "delta": _num(value.get("delta")),
        "series": _downsample(clean),
        "unit": unit,
    }


def build_payload(summary, sleep, as_of, extras=None, activity_names=True,
                  weight_unit="kg"):
    dto = _get(sleep, "dailySleepDTO") or {}
    secs = dto.get("sleepTimeSeconds")
    extras = extras or {}
    payload = {
        "ok": True, "stale": False, "asOf": as_of,
        "bodyBattery": {
            "current": summary.get("bodyBatteryMostRecentValue"),
            "high": summary.get("bodyBatteryHighestValue"),
            "low": summary.get("bodyBatteryLowestValue"),
        },
        "sleep": {
            "score": _get(dto, "sleepScores", "overall", "value"),
            "durationMin": round(secs / 60) if secs else None,
        },
        "steps": {"count": summary.get("totalSteps"),
                  "goal": summary.get("dailyStepGoal")},
        "restingHr": summary.get("restingHeartRate"),
    }
    # Every extended key is always present — null when the endpoint was
    # unavailable — so the QML side can branch on null instead of undefined.
    payload["curve"] = build_curve(extras.get("bodyBattery"), extras.get("stress"))
    payload["hrvStatus"] = build_hrv(extras.get("hrvStatus"))
    payload["readiness"] = build_readiness(extras.get("readiness"))
    payload["intensityMinutes"] = build_intensity(extras.get("intensityMinutes"))
    payload["floors"] = build_floors(summary)
    payload["calories"] = build_calories(summary)
    payload["activities"] = build_activities(extras.get("activities"),
                                             activity_names=activity_names)
    payload["lastActivity"] = payload["activities"][0] if payload["activities"] else None
    # `weight` is None both when the endpoint failed and when it was never
    # asked for (the token is not in the effective deck) — extras.get simply
    # returns None either way, and build_weight(None, ...) is None too.
    payload["weight"] = build_weight(extras.get("weight"), weight_unit)
    return payload


# A sentinel distinct from None: _safe's caller must be able to tell "the
# endpoint raised" from "the endpoint answered with nothing" — the first is
# eligible to carry the previous cache forward (v0.5 A5), the second is a
# real, current answer of "no data today" and must not be papered over with
# yesterday's number. `object()` rather than a string/None because it must
# never compare equal to anything a real response could contain.
FAILED = object()

# Extras keys eligible to carry the last cached value forward when the live
# call raises (v0.5 A5). Named in payload-key space (not the extras dict's
# own keys) since that's what cmd_fetch substitutes into. `curve` is
# deliberately absent — an intraday series is day-bound; yesterday's curve
# under today's label would be a lie even when marked stale.
#
# `weight` joins this list (PR #1 port): a 30-day timeline is exactly the
# kind of sparse, slow-moving series where one failed fetch blanking the
# whole card would be worse than showing last poll's (marked-stale) one.
# It only ever *is* a candidate to carry when the card was actually asked
# for — see _fetch_extras: the key is simply absent from `raw` otherwise,
# so it can never end up in `failed` for a disabled card.
CARRY_KEYS = ("hrvStatus", "readiness", "intensityMinutes", "activities", "weight")


def _activities_or_failed(fn):
    """FAILED unless the call answers with a list, or a dict carrying an
    activityList list (v0.5 amendment 5). A raised call is FAILED as usual;
    a call that *answers* with None, {}, or some other shape is now FAILED
    too — "answered with nothing" and "didn't answer at all" are different
    endpoints (garminconnect returning None for a day with no activities)
    and only the second is eligible to carry the cache forward. A genuine
    empty list stays [] and is not carried.
    """
    v = _safe(fn)
    if v is FAILED:
        return FAILED
    if isinstance(v, list):
        return v
    if isinstance(v, dict) and isinstance(v.get("activityList"), list):
        return v
    return FAILED


def _safe(fn):
    """Run one secondary API call; a failure returns FAILED, nothing more.

    The extended metrics come from six separate endpoints, any of which can
    404 for a day with no data, or 500, or vanish in the next garminconnect
    release. One of them failing must never cost the user their body battery
    chip, so each is isolated here rather than sharing fetch's try block.
    FAILED (not None) so the caller can tell a raised call apart from an
    endpoint that genuinely answered "nothing for today".
    """
    try:
        return fn()
    except Exception:
        return FAILED


def _fetch_extras(g, today, skip_body_battery=False, fetch_weight=False):
    """(extras, failed) — extras has FAILED replaced by None for the
    builders below; failed is the set of extras keys (payload-key spelling)
    whose live call raised, for cmd_fetch's carry-forward step.

    On a burst poll the ranged body-battery call already covers today (it is
    the same endpoint with an end date), so the day call is skipped and
    cmd_fetch fills the key from the window instead — that skip is not a
    failure, so it is never in `failed`.

    `get_weigh_ins` (PR #1 port) is the one endpoint here that is not always
    asked for: weight is sensitive data nobody should pay a fetch for
    without opting in, so `fetch_weight` (cmd_fetch's `--weight`, set only
    when the effective panel deck includes the `weight` token) gates
    whether the key even enters `raw` at all. Left out entirely rather than
    set to a "skip" sentinel like bodyBattery above, so it can never be
    mistaken for a failure and carried.
    """
    raw = {
        "bodyBattery": None if skip_body_battery else _safe(lambda: g.get_body_battery(today)),
        "stress": _safe(lambda: g.get_stress_data(today)),
        "hrvStatus": _safe(lambda: g.get_hrv_data(today)),
        "readiness": _safe(lambda: g.get_training_readiness(today)),
        "intensityMinutes": _safe(lambda: g.get_intensity_minutes_data(today)),
        "activities": _activities_or_failed(lambda: g.get_activities(0, ACTIVITY_LIMIT)),
    }
    if fetch_weight:
        weight_start = (datetime.date.fromisoformat(today)
                        - datetime.timedelta(days=WEIGHT_DAYS - 1)).isoformat()
        raw["weight"] = _safe(lambda: g.get_weigh_ins(weight_start, today))
    failed = {k for k, v in raw.items() if v is FAILED}
    extras = {k: (None if v is FAILED else v) for k, v in raw.items()}
    return extras, failed

def _secure_tokens() -> None:
    """Re-tighten tokens.json to 0600, best-effort.

    garminconnect refreshes the OAuth token behind our back inside
    login(tokenstore=...) and writes it back through Client.dump(), which
    honours the ambient umask — a 0600 file we created becomes 0644 the first
    time the token rolls over. These are bearer credentials for the account,
    so the mode is re-asserted after every call that can rewrite the file.
    """
    try:
        _chmod_guarded(TOKENS_PATH, 0o600)
        # Also the directory: installs made by an earlier version of this
        # helper left it at 0755, and fetch is the code path that actually
        # runs on those machines.
        _chmod_guarded(TOKENS_PATH.parent, 0o700, directory=True)
    except OSError:
        pass

def _secure_config_dir() -> None:
    """Create ~/.config/garmin-widget as 0700 (and tighten it if it exists)."""
    try:
        TOKENS_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        _chmod_guarded(TOKENS_PATH.parent, 0o700, directory=True)
    except OSError:
        pass

def _classify(e, default="api-error") -> str:
    """Sort an exception into an error category the widget knows how to show.

    Rate limiting is the API talking — not the network, and not a bad
    password. `default` is what everything unrecognised becomes: api-error
    during a fetch, but auth-expired during a login, where a plain failure
    really does mean the credentials did not work.
    """
    name = type(e).__name__
    if "TooManyRequests" in name:
        return "api-error"
    if isinstance(e, (ConnectionError, OSError, TimeoutError)) or "Connection" in name:
        return "offline"
    return default

SAFE_HINTS = (DEPS_HINT, "run: garmin-widget login")


def _load_cache():
    """The last good payload, with its advisory strings re-derived, or None.

    Anything that can write ~/.cache/garmin-widget/last.json chooses text the
    panel puts in front of the user: `hint` is rendered as the suggested fix
    and `detail` shows in the tooltip. A cached payload is a *success* payload
    and carries neither, so both keys are dropped on the way back out — except
    for a hint that is byte-for-byte one of this helper's own two literals,
    which carries no attacker-chosen content by definition.
    """
    try:
        cached = _read_json_guarded(CACHE_PATH, MAX_CACHE_BYTES)
    except Exception:
        return None
    if not isinstance(cached, dict):
        return None
    # A demo payload is fiction (v0.5 QC amendment 2): refused outright, not
    # stripped of its flag — stripped, it would be served as stale real data
    # or carried into a real card. cmd_demo never writes last.json, so one
    # only gets here by hand or by a bug; either way there is no cache.
    if cached.get("demo") is True:
        return None
    cached.pop("demo", None)
    hint = cached.pop("hint", None)
    cached.pop("detail", None)
    # `carried` is this helper's own bookkeeping for the fetch that produced
    # the payload, not a fact about the cached data itself — a cached
    # payload is a *success* payload and gets a fresh, empty `carried` from
    # whichever code path serves it, exactly like `stale` above it.
    cached.pop("carried", None)
    # The rest of the cached payload is still strings someone else may have
    # chosen: every one of them gets the same label-sized budget the live
    # build_* path applies, walked recursively so nothing rides in nested.
    cached = _clip_strings(cached)
    if isinstance(hint, str) and hint in SAFE_HINTS:
        cached["hint"] = hint
    if isinstance(cached.get("activities"), list):
        # v0.5 amendment 4: a cached activities list is re-run through the
        # whitelist + cap on every load, not just at fetch time — this is
        # the one place both the stale-cache-serving branch (above, in
        # cmd_fetch) and the carry-forward branch go through, so a hand-
        # edited last.json (extra keys planted onto an entry, or a
        # 10,000-row list) can't smuggle anything past either path. A pre-
        # v0.5 row (bare "date", no "start") is migrated first so it still
        # sorts and displays instead of being silently dropped.
        cached["activities"] = build_activities(
            [_migrate_legacy_activity(e) for e in cached["activities"]])
    if isinstance(cached.get("weight"), dict):
        # Same discipline as activities above, per PR #1's port (item 4):
        # a cached `weight` object is re-whitelisted on every load so a
        # hand-edited last.json can't smuggle an extra field or a padded
        # series past the stale-cache-serving or carry-forward paths.
        cached["weight"] = _rebuild_cached_weight(cached["weight"])
    return cached


def _migrate_legacy_activity(entry):
    """A 0.4-and-earlier activity/lastActivity dict has `date` but no
    `start` — hand it a `start` too so build_activity's lookup finds it.
    `date` alone is only 10 characters (no time-of-day), so the derived
    `start` is short; that degrades gracefully (still sorts, still shows a
    day) rather than fabricating a time that was never recorded."""
    if isinstance(entry, dict) and "start" not in entry and isinstance(entry.get("date"), str):
        return dict(entry, start=entry["date"])
    return entry

def cmd_fetch(week=False, weight=False) -> int:
    """Today's payload, plus the trailing week of history.

    `week` (the `--week` flag) forces the ranged window fetch; otherwise it
    runs only on the first successful fetch of a calendar day. Every other
    poll is today-only — the same eight calls v0.2 made.

    `weight` (the `--weight` flag, PR #1 port) asks the helper to also fetch
    the 30-day weigh-in timeline. The helper itself has no way to know the
    panel's effective deck — prefs.json can only tell it about an override,
    never about the shell/manifest default the panel falls back to when
    there is no override — so Service.qml computes that (the same way it
    already gates the `custom` card's command) and passes the flag down.
    Simplest robust option: the caller who actually knows the deck says so,
    rather than the helper guessing from a file it may not even have.
    """
    if not HAS_GARMINCONNECT:
        return emit({"ok": False, "error": "deps",
                     "hint": DEPS_HINT})
    if not TOKENS_PATH.exists():
        return emit({"ok": False, "error": "no-tokens",
                     "hint": "run: garmin-widget login"})
    import garminconnect as gc
    today = datetime.date.today().isoformat()
    now = datetime.datetime.now().isoformat(timespec="minutes")
    try:
        g = gc.Garmin()
        g.login(tokenstore=str(TOKENS_PATH))
        # Inline, not just in the finally: login() may have rewritten the
        # token file at the ambient umask, and everything below is network
        # I/O that can take seconds. A SIGTERM in that window (logout, a
        # bar restart) would otherwise leave a world-readable credential.
        _secure_tokens()
        cached_days, fetched_on = _load_history()
        burst = week or fetched_on != today
        summary = g.get_user_summary(today) or {}
        sleep = g.get_sleep_data(today) or {}
        # get_unit_system() is a local attribute set during login(), not a
        # network call, so this costs nothing against the fetch budget —
        # still only asked for when weight was actually requested, since
        # the unit is meaningless otherwise.
        weight_unit = _weight_unit(g) if weight else "kg"
        extras, failed_keys = _fetch_extras(g, today, skip_body_battery=burst,
                                            fetch_weight=weight)
        window = _fetch_window(g, _window_dates(today)[0], today) if burst else {}
        readiness_backfill = {}
        if burst:
            # The ranged answer carries today; fall back to the day call only
            # when the ranged one failed, so the curve is never silently lost.
            bb = _today_from_range(window.get("bodyBattery"), today)
            if bb is None:
                bb = _safe(lambda: g.get_body_battery(today))
                if bb is FAILED:
                    bb = None
            extras["bodyBattery"] = bb
            # Readiness backfill (v0.5 extra step): garminconnect 0.3.11 has
            # no ranged get_training_readiness, so a day the machine was
            # asleep for never gets one from the window like every other
            # field does. On a burst, ask for it explicitly — but only for
            # the window days (today excluded; it already gets a live
            # value above) that don't already have a score cached, so a
            # laptop that slept through a whole weekend backfills both
            # days the next time it wakes up rather than one call per poll
            # forever. One extra call per missing day, isolated with
            # _safe like every other secondary endpoint.
            have_readiness = {e.get("date") for e in cached_days
                              if isinstance(e, dict) and e.get("readiness") is not None}
            for d in _window_dates(today)[:-1]:
                if d in have_readiness:
                    continue
                r = _safe(lambda d=d: g.get_training_readiness(d))
                if r is FAILED:
                    continue
                built = build_readiness(r)
                if built and built.get("score") is not None:
                    readiness_backfill[d] = built["score"]
        activity_names = _read_prefs().get("activityNames", True)
        payload = build_payload(summary, sleep, now, extras,
                                activity_names=activity_names,
                                weight_unit=weight_unit)
        # Per-domain freshness (v0.5 A5): a secondary endpoint that *raised*
        # keeps its last cached value (marked in `carried`) instead of
        # blanking its card — but only for keys in CARRY_KEYS; an endpoint
        # that simply answered "nothing for today" (empty/None body, not an
        # exception) is a real, current answer and is never carried.
        carried = []
        to_carry = failed_keys & set(CARRY_KEYS)
        if to_carry:
            cached = _load_cache() or {}
            for key in CARRY_KEYS:
                if key not in to_carry:
                    continue
                cached_value = cached.get(key)
                if cached_value is not None:
                    payload[key] = cached_value
                carried.append(key)
            if "activities" in carried:
                # lastActivity follows activities rather than being carried
                # itself (A3/A5) — recompute it from whatever activities
                # ended up in the payload, carried or not.
                payload["lastActivity"] = (payload["activities"][0]
                                           if payload["activities"] else None)
        payload["carried"] = carried
    except gc.GarminConnectAuthenticationError:
        return emit({"ok": False, "error": "auth-expired",
                     "hint": "run: garmin-widget login"})
    except Exception as e:
        cached = _load_cache()
        if cached is not None:
            cached["stale"] = True
            # A stale payload already says everything; it carries nothing
            # forward of its own (that bookkeeping belongs to a fetch that
            # actually ran), but the key is always present for the panel.
            cached["carried"] = []
            # detail is the exception *class name* only, same rule as the
            # no-cache branch below — and it rides on the emitted object
            # only, not on `cached` before this point, so it never reaches
            # last.json (that write already happened when this payload was
            # fresh; _load_cache also strips any detail a prior write left).
            cached["detail"] = type(e).__name__
            return emit(cached)
        # detail is the exception *class name* only. str(e) on a garminconnect
        # error routinely carries the account email or a token path, and this
        # string ends up in a bar tooltip.
        return emit({"ok": False, "error": _classify(e),
                     "detail": type(e).__name__})
    finally:
        # login() may have refreshed and rewritten the token file at the
        # ambient umask, whether or not the rest of the call succeeded.
        if TOKENS_PATH.exists():
            _secure_tokens()
    # A stale or failed fetch returned above and never gets here, so history
    # is only ever rewritten from a payload Garmin actually answered.
    payload["history"] = _update_history(payload, today, window, burst,
                                         readiness_backfill)
    _write_cache(payload)
    return emit(payload)

def _atomic_write(path: Path, obj, prefix: str) -> None:
    """Replace `path` with json(obj) atomically, at 0600, or not at all.

    A torn write is worse than a missing file: the next offline fetch would
    read half a JSON object, fall through to the generic error branch, and the
    bar would blank instead of showing yesterday's numbers. Writing a sibling
    temp file and os.replace()ing it means readers only ever see a whole file.
    Still best-effort overall — a full or read-only disk must not break fetch.
    """
    tmp = None
    try:
        # The cache holds days of health data; v0.1 installs created this
        # directory at 0755, so the mode is re-asserted, not just requested.
        # No inner try: reads through a symlinked plugin dir are refused, so
        # writes through one must be too — a raise here lands in the outer
        # best-effort except and the write is skipped rather than redirected.
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        _chmod_guarded(path.parent, 0o700, directory=True)
        fd, tmp = tempfile.mkstemp(dir=str(path.parent),
                                   prefix=prefix, suffix=".json")
        with os.fdopen(fd, "w") as fh:
            json.dump(obj, fh)
            # mkstemp already made it 0600 and os.replace preserves that,
            # but these files hold days of health data, so the mode is
            # asserted rather than assumed — on the fd, before the file
            # becomes reachable at `path`, so there is nothing to swap.
            os.fchmod(fh.fileno(), 0o600)
        os.replace(tmp, path)  # same directory, so this is atomic
        tmp = None
    except Exception:
        pass  # best-effort; must never break fetch
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except Exception:
                pass

def _write_cache(payload) -> None:
    _atomic_write(CACHE_PATH, payload, ".last-")

def _load_history():
    """(days, windowFetchedOn) — whatever of history.json is usable. Never raises.

    A truncated or hand-edited file must not cost the user their fetch, so
    anything unreadable is treated as "no history yet" and gets overwritten
    on the next successful poll. Pre-0.3 installs wrote the bare day list and
    0.2/0.3 wrote {"backfilled", "days"}; both read as "window never fetched",
    which is exactly right — the next fetch pulls the week and rewrites them.
    """
    try:
        data = _read_json_guarded(HISTORY_PATH, MAX_CACHE_BYTES)
    except Exception:
        return [], None
    fetched_on = None
    if isinstance(data, dict):
        stamp = data.get("windowFetchedOn")
        fetched_on = stamp if isinstance(stamp, str) else None
        data = data.get("days")
    if not isinstance(data, list):
        return [], None
    return ([e for e in data
             if isinstance(e, dict) and isinstance(e.get("date"), str)],
            fetched_on)


def _dict(v):
    return v if isinstance(v, dict) else {}


def _list(v):
    return v if isinstance(v, list) else []


def _minutes(secs):
    n = _num(secs)
    return None if n is None else round(n / 60)


def _window_dates(today):
    """The seven ISO dates ending on `today`, oldest first."""
    end = datetime.date.fromisoformat(today)
    return [(end - datetime.timedelta(days=n)).isoformat()
            for n in range(HISTORY_DAYS - 1, -1, -1)]


def _fetch_window(g, start, end):
    """Raw ranged responses for start..end, keyed by source.

    One call per source, each isolated: a source that raises is simply absent
    from the result, and absence means "leave the cache alone" downstream.
    The stress path is a raw connectapi() call — garminconnect has no wrapper
    for the daily stress summary — and is the least documented thing here;
    if Garmin moves it, the stress fields stop updating and nothing else does.
    """
    calls = {
        "steps": lambda: g.get_daily_steps(start, end),
        "rhr": lambda: g.get_rhr_daily(start, end),
        "sleep": lambda: g.get_sleep_daily(start, end),
        "bodyBattery": lambda: g.get_body_battery(start, end),
        "hrv": lambda: g.get_hrv_data_range(start, end),
        "calories": lambda: g.get_calories_daily(start, end),
        "stress": lambda: g.connectapi(
            f"/usersummary-service/stats/stress/daily/{start}/{end}"),
    }
    out = {}
    for name, fn in calls.items():
        try:
            out[name] = fn()
        except Exception:
            pass
    return out


def _today_from_range(days, today):
    """The ranged body-battery entry for `today`, in the list shape
    build_curve expects — or None."""
    for d in _list(days):
        if isinstance(d, dict) and d.get("date") == today:
            return [d]
    return None


def _bb_levels(day):
    """Numeric body battery levels from one ranged day entry, nulls dropped.

    Negative values are dropped too, same as _series() above: Garmin's own
    "no valid reading" sentinel is negative, and a high/low computed over one
    would report a battery level that never happened.
    """
    rows = _list(day.get("bodyBatteryValuesArray"))
    vi = _desc_index(day.get("bodyBatteryValueDescriptorDTOList"), "bodyBatteryLevel")
    vi = 1 if vi is None else vi
    out = []
    for r in rows:
        if isinstance(r, (list, tuple)) and len(r) > vi:
            v = _num(r[vi])
            if v is not None and v >= 0:
                out.append(v)
    return out


def _window_rows(raw):
    """{date: {field: value}} from the raw ranged responses.

    Only real values are recorded. A day a source did not mention, or
    mentioned with a null, contributes nothing — so downstream a missing key
    means "no news", never "the value is now nothing".
    """
    rows = {}

    def put(date, field, value):
        if isinstance(date, str) and value is not None:
            rows.setdefault(date, {})[field] = value

    for r in _list(raw.get("steps")):
        r = _dict(r)
        put(r.get("calendarDate"), "steps", _round(r.get("totalSteps")))
        put(r.get("calendarDate"), "stepGoal", _round(r.get("stepGoal")))
    for r in _list(raw.get("rhr")):
        r = _dict(r)
        put(r.get("calendarDate"), "restingHr", _round(r.get("value")))
    for r in _list(raw.get("sleep")):
        r = _dict(r)
        v = _dict(r.get("values"))
        d = r.get("calendarDate")
        put(d, "sleepScore", _round(v.get("sleepScore")))
        put(d, "sleepMin", _minutes(v.get("totalSleepTimeInSeconds")))
        put(d, "deepMin", _minutes(v.get("deepTime")))
        put(d, "lightMin", _minutes(v.get("lightTime")))
        put(d, "remMin", _minutes(v.get("remTime")))
        put(d, "awakeMin", _minutes(v.get("awakeTime")))
    for r in _list(raw.get("bodyBattery")):
        r = _dict(r)
        d = r.get("date")
        levels = _bb_levels(r)
        if levels:
            put(d, "bbHigh", round(max(levels)))
            put(d, "bbLow", round(min(levels)))
        put(d, "bbCharged", _round(r.get("charged")))
        put(d, "bbDrained", _round(r.get("drained")))
    for r in _list(_dict(raw.get("hrv")).get("hrvSummaries")):
        r = _dict(r)
        d = r.get("calendarDate")
        base = _dict(r.get("baseline"))
        put(d, "hrvNight", _round(r.get("lastNightAvg")))
        put(d, "hrvWeekly", _round(r.get("weeklyAvg")))
        put(d, "hrvBalLow", _round(base.get("balancedLow")))
        put(d, "hrvBalHigh", _round(base.get("balancedUpper")))
    for r in _list(raw.get("calories")):
        r = _dict(r)
        put(r.get("calendarDate"), "calActive", _round(r.get("active")))
        put(r.get("calendarDate"), "calResting", _round(r.get("resting")))
    for r in _list(raw.get("stress")):
        r = _dict(r)
        v = _dict(r.get("values"))
        d = r.get("calendarDate")
        put(d, "stressAvg", _round(v.get("overallStressLevel")))
        put(d, "stressRestMin", _minutes(v.get("restStressDuration")))
        put(d, "stressLowMin", _minutes(v.get("lowStressDuration")))
        put(d, "stressMedMin", _minutes(v.get("mediumStressDuration")))
        put(d, "stressHighMin", _minutes(v.get("highStressDuration")))
    return rows


def _live_row(payload):
    """Today's history fields as the live payload knows them (values only)."""
    total = _num(_get(payload, "calories", "total"))
    active = _num(_get(payload, "calories", "active"))
    row = {
        "steps": _get(payload, "steps", "count"),
        "stepGoal": _get(payload, "steps", "goal"),
        "sleepScore": _get(payload, "sleep", "score"),
        "sleepMin": _get(payload, "sleep", "durationMin"),
        "bbHigh": _get(payload, "bodyBattery", "high"),
        "bbLow": _get(payload, "bodyBattery", "low"),
        "restingHr": payload.get("restingHr"),
        "readiness": _get(payload, "readiness", "score"),
        "hrvNight": _get(payload, "hrvStatus", "lastNightAvg"),
        "hrvWeekly": _get(payload, "hrvStatus", "weeklyAvg"),
        "calActive": active,
        "calResting": (round(total - active)
                       if total is not None and active is not None else None),
    }
    return {k: v for k, v in row.items() if _num(v) is not None}


def _merge_row(date, layers):
    """One full-schema row: later layers win, but only with real numbers.

    Legacy names are mapped, unknown keys dropped, and anything that is not a
    number (a planted string, a bool) is treated as absent — the cache is a
    file anyone with the home directory can edit.
    """
    row = {"date": date}
    row.update({f: None for f in HISTORY_FIELDS})
    for layer in layers:
        for k, v in _dict(layer).items():
            k = LEGACY_FIELDS.get(k, k)
            if k in HISTORY_FIELDS and _num(v) is not None:
                row[k] = v
    return row


def _merge_history(cached, fetched_on, payload, today, window=None, burst=False):
    """Pure merge: cache + window + today's payload -> (rows, new fetched_on).

    Per date, per field: live today > window > cache, and only values move —
    a source that failed or had nothing for a day leaves the cached number
    where it is. The list is pruned to the calendar week ending today, so a
    row older than that goes even when the file is short. Today always gets a
    row, even an all-null one on an empty morning, because the panel aligns
    its strips on the newest date.

    The stamp only goes down when a burst *landed something*: `window` is the
    raw per-source dict from `_fetch_window`, and it's empty when every ranged
    call raised (a network blip, a rate limit). Stamping on an empty burst
    would leave the week stuck at whatever the cache already had until
    tomorrow; leaving it unset means the very next poll bursts again instead.

    No I/O here — `cached` (a list of day dicts) and `fetched_on` are handed
    in rather than read from history.json, so the same function can run
    against an empty cache (a future demo mode) or against whatever
    _load_history() actually returned.
    """
    dates = _window_dates(today)
    by_date = {}
    for e in cached:
        if e.get("date") in dates:
            by_date.setdefault(e["date"], []).append(e)
    win = _window_rows(_dict(window))
    live = _live_row(payload)
    rows = []
    for d in dates:
        layers = list(by_date.get(d, []))
        if d in win:
            layers.append(win[d])
        if d == today:
            layers.append(live)
        if not layers and d != today:
            continue
        rows.append(_merge_row(d, layers))
    if burst and window:
        fetched_on = today
    return rows, fetched_on


def _update_history(payload, today, window=None, burst=False, readiness_backfill=None):
    """I/O wrapper around _merge_history: load, merge, write, return the rows.

    `readiness_backfill` ({date: score}, v0.5 extra step) is applied after
    the merge, deliberately outside _merge_history/its window-landed-
    something stamp logic: it is a separate, best-effort enhancement (its
    own calls, its own failures) and must never affect whether the *real*
    window burst is considered to have landed. It also can't invent a row —
    a date _merge_history dropped for having no other data stays dropped,
    and only ever raises an existing readiness of None, never overwrites a
    real number.

    The payload keeps carrying a plain list; the {"windowFetchedOn", "days"}
    wrapper is the on-disk format only.
    """
    try:
        cached, fetched_on = _load_history()
        rows, fetched_on = _merge_history(cached, fetched_on, payload, today,
                                          window, burst)
        _apply_readiness_backfill(rows, readiness_backfill)
        _atomic_write(HISTORY_PATH, {"windowFetchedOn": fetched_on,
                                     "days": rows}, ".history-")
        return rows
    except Exception:
        return []


def _apply_readiness_backfill(rows, readiness_backfill):
    """Fill a null readiness from {date: score}, in place. Pure.

    Split out of _update_history so the demo can run the very same rule
    over its synthetic week without the load/write around it.
    """
    if not readiness_backfill:
        return
    by_date = {r.get("date"): r for r in rows}
    for d, score in readiness_backfill.items():
        row = by_date.get(d)
        if row is not None and row.get("readiness") is None:
            row["readiness"] = score


# ---- demo ------------------------------------------------------------------
#
# `garmin-widget demo` prints a full payload made from synthetic data, for
# trying the widget without an account and for screenshots (v0.5 D1-D5).
#
# The data is made as *raw Garmin-shaped responses* — what get_user_summary,
# get_sleep_data, get_stress_data, the ranged week calls, get_activities and
# get_weigh_ins answer — and pushed through the same builders a live fetch
# uses (build_payload, _merge_history, build_activities, build_weight). A
# builder regression therefore breaks the demo too, and the demo can never
# carry a field a live payload cannot.
#
# Nothing is read or written: no tokens, no cache, no history, no prefs. The
# history merge runs against an empty cache. Stdlib only, dispatched before
# the venv re-exec (main()), so it works on a box with no venv at all.
#
# Deterministic: a fixed seed and a fixed synthetic clock, with dates anchored
# on the real today so weekday labels are current — the same output, byte for
# byte, for a given calendar day.

DEMO_SEED = 0x6A726D6E
DEMO_CLOCK = "18:40"   # most of a day, so the curve is not a morning stub

# Week tables, indexed by `back` (0 = today ... 6). Today's column matches
# the summary/sleep answers below, so the merge's "live beats window" rule
# has nothing to disagree about.
_DEMO_STEPS = (7480, 10350, 5820, 3900, 11040, 8760, 6230)
_DEMO_STEP_GOALS = (9000, 9000, 8500, 9500, 9000, 8500, 9500)
_DEMO_SLEEP_MIN = (432, 405, 470, 365, 441, 389, 452)
_DEMO_SLEEP_SCORE = (79, 74, 84, 61, 80, 70, 82)
_DEMO_AWAKE_MIN = (18, 26, 12, 41, 15, 30, 22)
_DEMO_RHR = (51, 50, 52, 55, 49, 51, 53)
_DEMO_HRV = (52, 55, 49, 41, 58, 50, 47)
_DEMO_BB_HIGH = (88, 74, 91, 79, 86, 82, 77)
_DEMO_BB_LOW = (34, 22, 38, 12, 30, 27, 19)
_DEMO_BB_CHARGED = (54, 52, 70, 67, 56, 55, 58)
_DEMO_BB_DRAINED = (47, 66, 44, 61, 59, 40, 63)
_DEMO_STRESS = (32, 28, 36, 44, 25, 30, 38)
_DEMO_CAL_ACTIVE = (640, 510, 910, 380, 720, 560, 450)
_DEMO_CAL_RESTING = 1670
_DEMO_READINESS = (68, 72, 83, 44, 77, 61, 58)

# (back, hour, minute, typeKey, name, minutes, km, avgHr, maxHr, kcal, elevM)
# Ten rows (= ACTIVITY_ROWS) over sixteen days, every card family covered.
_DEMO_ACTIVITIES = (
    (0, 7, 5, "running", "Morning Run", 46, 8.12, 146, 172, 498, 64),
    (1, 18, 20, "road_biking", "Evening Ride", 84, 31.6, 131, 163, 742, 318),
    (2, 12, 30, "strength_training", "Lunch Strength", 38, None, 112, 149, 236, None),
    (4, 9, 15, "hiking", "Ridge Loop", 172, 11.4, 118, 151, 961, 642),
    (5, 6, 50, "lap_swimming", "Pool Swim", 41, 1.85, 127, 158, 364, None),
    (6, 17, 45, "running", "Tempo Intervals", 52, 9.46, 158, 181, 603, 41),
    (8, 8, 0, "walking", "Park Walk", 64, 5.23, 96, 118, 281, 22),
    (10, 16, 10, "cycling", "Commute Home", 29, 11.2, 124, 150, 268, 76),
    (12, 19, 30, "yoga", "Yoga Flow", 45, None, 88, 109, 142, None),
    (15, 7, 40, "running", "Long Run", 108, 19.8, 141, 166, 1204, 187),
)

# Sparse weigh-ins over WEIGHT_DAYS (back, hour, kg): drifting gently down,
# with gaps, the way a real bathroom scale gets used.
_DEMO_WEIGH_INS = ((0, 7, 74.6), (2, 7, 74.9), (4, 8, 75.1), (7, 7, 75.0),
                   (9, 7, 75.4), (12, 8, 75.3), (15, 7, 75.8), (18, 7, 75.6),
                   (21, 8, 76.1), (25, 7, 75.9), (28, 7, 76.3))


def _demo_ms(day, hh, mm):
    return int(datetime.datetime.combine(day, datetime.time(hh, mm)).timestamp() * 1000)


def _demo_curves(today, rng):
    """(bodyBattery rows, stress rows) — 3-minute samples, 00:00..DEMO_CLOCK.

    Body battery charges from 34 at midnight to 88 by 07:10, then steps down
    through the day to 41 at the clock; stress runs roughly inverse, 12..71,
    with two runs of -1 (watch off the wrist) so the sentinel-dropping path
    in _series stays exercised by the demo too.
    """
    hh, mm = (int(x) for x in DEMO_CLOCK.split(":"))
    end, peak = hh * 60 + mm, 7 * 60 + 10
    t0 = _demo_ms(today, 0, 0)
    bb, stress = [], []
    for minute in range(0, end + 1, 3):
        if minute <= peak:
            level = 34 + (88 - 34) * (minute / peak) ** 0.8
        else:
            f = (minute - peak) / (end - peak)
            # A staircase rather than a ramp: drains come in efforts.
            level = 88 - (88 - 41) * (0.55 * f + 0.45 * (int(f * 6) / 6))
        level = max(34, min(88, round(level + rng.uniform(-1, 1))))
        if minute == 0:
            level = 34
        elif peak <= minute < peak + 3:
            level = 88
        elif minute + 3 > end:
            level = 41
        base = 12 + (71 - 12) * (1 - (level - 34) / (88 - 34))
        s = max(12, min(71, round(base * (0.55 if minute < peak else 1.0)
                                  + rng.uniform(-6, 6))))
        if 600 <= minute < 615 or 930 <= minute < 942:
            s = -1
        ts = t0 + minute * 60_000
        bb.append([ts, level])
        stress.append([ts, s])
    return bb, stress


def _demo_raw(today, weight=False):
    """The synthetic Garmin responses one burst fetch would have received.

    Returns (summary, sleep, extras, window, readiness_backfill) in exactly
    the shapes cmd_fetch hands the builders (tests/fixtures.py records the
    real layouts these copy).
    """
    rng = random.Random(DEMO_SEED)
    day = lambda back: (today - datetime.timedelta(days=back)).isoformat()
    backs = range(HISTORY_DAYS - 1, -1, -1)
    # The week's peak lands on its Saturday (a past one: today keeps the
    # figure the summary reports), so the steps strip has a shape to it.
    steps = [13200 if b > 0 and (today - datetime.timedelta(days=b)).weekday() == 5
             else _DEMO_STEPS[b] for b in range(HISTORY_DAYS)]

    summary = {
        "bodyBatteryMostRecentValue": 41, "bodyBatteryHighestValue": 88,
        "bodyBatteryLowestValue": 34,
        "totalSteps": _DEMO_STEPS[0], "dailyStepGoal": _DEMO_STEP_GOALS[0],
        "restingHeartRate": _DEMO_RHR[0],
        "floorsAscended": 9, "userFloorsAscendedGoal": 10,
        "totalKilocalories": _DEMO_CAL_RESTING + _DEMO_CAL_ACTIVE[0],
        "activeKilocalories": _DEMO_CAL_ACTIVE[0],
    }
    sleep = {"dailySleepDTO": {
        "calendarDate": day(0), "sleepTimeSeconds": _DEMO_SLEEP_MIN[0] * 60,
        "sleepScores": {"overall": {"value": _DEMO_SLEEP_SCORE[0]}}}}

    bb_rows, stress_rows = _demo_curves(today, rng)
    stress = {
        "calendarDate": day(0),
        "stressValueDescriptorsDTOList": [{"index": 0, "key": "timestamp"},
                                          {"index": 1, "key": "stressLevel"}],
        "stressValuesArray": stress_rows,
        "bodyBatteryValueDescriptorsDTOList": [
            {"bodyBatteryValueDescriptorIndex": 0, "bodyBatteryValueDescriptorKey": "timestamp"},
            {"bodyBatteryValueDescriptorIndex": 1, "bodyBatteryValueDescriptorKey": "bodyBatteryStatus"},
            {"bodyBatteryValueDescriptorIndex": 2, "bodyBatteryValueDescriptorKey": "bodyBatteryLevel"},
            {"bodyBatteryValueDescriptorIndex": 3, "bodyBatteryValueDescriptorKey": "bodyBatteryVersion"}],
        "bodyBatteryValuesArray": [[t, "MEASURED", v, 3.0] for t, v in bb_rows],
    }

    # Sleep stages: deep/light/rem sum to the night's total exactly.
    def stages(back):
        total = _DEMO_SLEEP_MIN[back]
        deep, rem = round(total * 0.19), round(total * 0.23)
        return deep, total - deep - rem, rem

    bb_desc = [{"bodyBatteryValueDescriptorIndex": 0, "bodyBatteryValueDescriptorKey": "timestamp"},
               {"bodyBatteryValueDescriptorIndex": 1, "bodyBatteryValueDescriptorKey": "bodyBatteryLevel"}]

    def bb_day(back):
        d = today - datetime.timedelta(days=back)
        if back == 0:
            values = bb_rows
        else:
            values = [[_demo_ms(d, 0, 0), None],
                      [_demo_ms(d, 1, 0), _DEMO_BB_LOW[back]],
                      [_demo_ms(d, 7, 0), _DEMO_BB_HIGH[back]],
                      [_demo_ms(d, 22, 0), _DEMO_BB_LOW[back] + 6]]
        return {"date": day(back), "charged": _DEMO_BB_CHARGED[back],
                "drained": _DEMO_BB_DRAINED[back],
                "bodyBatteryValueDescriptorDTOList": bb_desc,
                "bodyBatteryValuesArray": values}

    window = {
        "steps": [{"calendarDate": day(b), "totalSteps": steps[b],
                   "stepGoal": _DEMO_STEP_GOALS[b]} for b in backs],
        "rhr": [{"calendarDate": day(b), "value": float(_DEMO_RHR[b])} for b in backs],
        "sleep": [{"calendarDate": day(b), "values": {
            "sleepScore": _DEMO_SLEEP_SCORE[b],
            "totalSleepTimeInSeconds": _DEMO_SLEEP_MIN[b] * 60,
            "deepTime": stages(b)[0] * 60, "lightTime": stages(b)[1] * 60,
            "remTime": stages(b)[2] * 60, "awakeTime": _DEMO_AWAKE_MIN[b] * 60}}
            for b in backs],
        "bodyBattery": [bb_day(b) for b in backs],
        "hrv": {"hrvSummaries": [
            {"calendarDate": day(b), "weeklyAvg": 49, "lastNightAvg": _DEMO_HRV[b],
             "baseline": {"balancedLow": 44, "balancedUpper": 63},
             "status": "BALANCED"} for b in backs]},
        "calories": [{"calendarDate": day(b), "active": float(_DEMO_CAL_ACTIVE[b]),
                      "resting": float(_DEMO_CAL_RESTING),
                      "total": float(_DEMO_CAL_RESTING + _DEMO_CAL_ACTIVE[b])}
                     for b in backs],
        "stress": [{"calendarDate": day(b), "values": {
            "overallStressLevel": _DEMO_STRESS[b],
            "restStressDuration": (560 - _DEMO_STRESS[b] * 3) * 60,
            "lowStressDuration": (300 + _DEMO_STRESS[b]) * 60,
            "mediumStressDuration": (120 + _DEMO_STRESS[b] * 2) * 60,
            "highStressDuration": (20 + _DEMO_STRESS[b]) * 60}} for b in backs],
    }

    activities = []
    for i, (back, hh, mm, type_key, name, mins, km, avg, mx, kcal, elev) in enumerate(_DEMO_ACTIVITIES):
        start = datetime.datetime.combine(today - datetime.timedelta(days=back),
                                          datetime.time(hh, mm))
        activities.append({
            "activityId": 90000001 + i,
            "activityName": name,
            "activityType": {"typeKey": type_key},
            "startTimeLocal": start.strftime("%Y-%m-%d %H:%M:%S"),
            # A fixed offset: only the ordering matters, and it must be the
            # same on every box for the output to be byte-identical.
            "startTimeGMT": (start - datetime.timedelta(hours=2)).strftime("%Y-%m-%d %H:%M:%S"),
            "duration": float(mins * 60),
            "distance": float(km * 1000) if km else 0.0,
            "averageHR": float(avg), "maxHR": float(mx),
            "calories": float(kcal),
            "elevationGain": float(elev) if elev else 0.0,
        })

    extras = {
        # A burst takes today's body battery from the ranged answer, as
        # cmd_fetch does, so the demo walks that path too.
        "bodyBattery": _today_from_range(window["bodyBattery"], day(0)),
        "stress": stress,
        "hrvStatus": {"hrvSummary": {"lastNightAvg": _DEMO_HRV[0], "weeklyAvg": 49,
                                     "status": "BALANCED",
                                     "baseline": {"balancedLow": 44, "balancedUpper": 63}}},
        "readiness": [{"score": _DEMO_READINESS[0], "level": "MODERATE",
                       "timestamp": day(0) + "T07:12:00.0"}],
        "intensityMinutes": {"weeklyTotal": 112, "weekGoal": 150},
        "activities": activities,
    }
    if weight:
        rows = []
        for back, hh, kg in _DEMO_WEIGH_INS:
            d = today - datetime.timedelta(days=back)
            rows.append({"calendarDate": d.isoformat(), "weight": kg * 1000,
                         "timestampGMT": _demo_ms(d, hh, 5), "sourceType": "MANUAL"})
        extras["weight"] = {"dailyWeightSummaries": [
            {"summaryDate": r["calendarDate"], "allWeightMetrics": [r]} for r in rows]}

    backfill = {}
    for b in range(1, HISTORY_DAYS):
        built = build_readiness([{"score": _DEMO_READINESS[b], "level": "MODERATE"}])
        backfill[day(b)] = built["score"]
    return summary, sleep, extras, window, backfill


def cmd_demo(weight=False) -> int:
    """A full synthetic payload, marked `"demo": true`. Reads and writes nothing.

    `weight` mirrors fetch's `--weight`: the Service passes the flag when the
    weight card is in the deck, and the demo follows the same one rule rather
    than always inventing a weight nobody asked to see.
    """
    today = datetime.date.today()
    summary, sleep, extras, window, backfill = _demo_raw(today, weight=weight)
    payload = build_payload(summary, sleep, "demo", extras, weight_unit="kg")
    rows, _ = _merge_history([], None, payload, today.isoformat(), window, burst=True)
    _apply_readiness_backfill(rows, backfill)
    payload["carried"] = []
    payload["history"] = rows
    payload["demo"] = True
    return emit(payload)

# ---- prefs -----------------------------------------------------------------
#
# The panel's edit mode is the only thing that writes these, and it does it
# through here rather than from QML: every file this plugin owns is created by
# this helper, atomically and at 0600, and a second writer with its own idea of
# permissions is exactly how a 0644 file appears six months later.

# Panel card tokens, in the order the panel's own list uses them. Kept in step
# with knownMetrics in Panel.qml — a token this helper drops is a card the
# panel can never be asked for again.
PANEL_METRICS = ("curve", "battery", "sleep", "steps", "readiness", "rhr",
                 "hrv", "intensity", "floors", "calories", "weight",
                 "activity", "custom")
BAR_METRICS = ("bodyBattery", "steps", "sleep", "readiness")

# A pref value is a short token list typed by a person, not a document. The cap
# is here so a runaway caller cannot turn prefs.json into a megabyte the panel
# re-parses on every startup.
MAX_PREF_VALUE = 512


def _invalid_pref() -> int:
    """One error for every bad pref — a wrong key, a wrong value, a missing
    argument. The panel does not act differently on any of them."""
    return emit({"ok": False, "error": "api-error", "detail": "InvalidPref"})


def _clean_panel_metrics(value):
    """Known tokens only, de-duplicated, order preserved. Never raises.

    Unknown tokens are dropped rather than rejected — the same rule the panel
    applies to the shell.json setting, so a stale token from a future version
    costs one card instead of the whole list.
    """
    out = []
    for part in str(value).split(","):
        token = part.strip().lower()
        if token in PANEL_METRICS and token not in out:
            out.append(token)
    return out


def _clean_bar_metric(value):
    """The canonical spelling of a known bar metric, or None."""
    token = str(value).strip().lower()
    for known in BAR_METRICS:
        if known.lower() == token:
            return known
    return None


def _read_prefs():
    """prefs.json, validated key by key. Anything else is not a pref.

    prefs.json is a file on disk like any other, so it is read as untrusted
    input: unknown keys are dropped (nothing else may ride into the panel this
    way), and a value that no longer validates is treated as absent, which
    falls the panel back to the shell.json setting rather than to nothing.
    """
    try:
        data = _read_json_guarded(PREFS_PATH, MAX_PREFS_BYTES)
    except Exception:
        return {}
    if not isinstance(data, dict):
        return {}
    out = {}
    metrics = data.get("panelMetrics")
    if isinstance(metrics, list):
        cleaned = _clean_panel_metrics(
            ",".join(str(m) for m in metrics[:len(PANEL_METRICS)]))
        if cleaned:
            out["panelMetrics"] = cleaned
    bar = data.get("barMetric")
    if isinstance(bar, str):
        cleaned_bar = _clean_bar_metric(bar)
        if cleaned_bar:
            out["barMetric"] = cleaned_bar
    # v0.5 Q3: an off-switch for activity names, for anyone who doesn't want
    # a city-shaped Garmin auto-name riding in last.json. Default on
    # (build_payload's own default), applied inside build_activity so
    # cmd_fetch reads this once and threads it through — the builders
    # themselves stay pure and disk-free.
    names = data.get("activityNames")
    if isinstance(names, bool):
        out["activityNames"] = names
    return out


def cmd_prefs(argv) -> int:
    action = argv[0] if argv else ""
    if action == "get":
        return emit({"ok": True, "prefs": _read_prefs()})
    if action != "set" or len(argv) < 3:
        return _invalid_pref()

    key, value = argv[1], argv[2]
    if len(str(value)) > MAX_PREF_VALUE:
        return _invalid_pref()

    prefs = _read_prefs()
    if key == "panelMetrics":
        cleaned = _clean_panel_metrics(value)
        # An empty list would read back as "no pref" and hand the panel back to
        # the shell.json setting — the opposite of what the user just asked for.
        if not cleaned:
            return _invalid_pref()
        prefs["panelMetrics"] = cleaned
    elif key == "barMetric":
        cleaned_bar = _clean_bar_metric(value)
        if cleaned_bar is None:
            return _invalid_pref()
        prefs["barMetric"] = cleaned_bar
    elif key == "activityNames":
        if value not in ("true", "false"):
            return _invalid_pref()
        prefs["activityNames"] = (value == "true")
    else:
        return _invalid_pref()

    _secure_config_dir()
    _atomic_write(PREFS_PATH, prefs, ".prefs-")
    # _atomic_write is deliberately best-effort — it must never break a fetch —
    # so the write is verified here instead. A pref that did not land must not
    # answer ok, or the panel shows a choice the next restart has forgotten.
    if _read_prefs() != prefs:
        return emit({"ok": False, "error": "api-error",
                     "detail": "PrefsWriteFailed"})
    return emit({"ok": True, "prefs": prefs})


def cmd_login() -> int:
    if not HAS_GARMINCONNECT:
        return emit({"ok": False, "error": "deps",
                     "hint": DEPS_HINT})
    import getpass
    import garminconnect as gc
    # Interactive prompts go to stderr so stdout stays JSON-only.
    print("Garmin Connect login (credentials go to Garmin only, "
          "tokens stay local).", file=sys.stderr)
    print("Email: ", end="", file=sys.stderr, flush=True)
    email = input()
    password = getpass.getpass("Password: ")

    def _prompt_mfa():
        print("MFA code: ", end="", file=sys.stderr, flush=True)
        return input()

    try:
        g = gc.Garmin(email=email, password=password,
                      prompt_mfa=_prompt_mfa)
        g.login()
        _secure_config_dir()
        g.client.dump(str(TOKENS_PATH))
        _secure_tokens()   # narrow the window before the finally block runs
    except Exception as e:
        # Rate limits and dead networks are not bad credentials. Reporting
        # them as auth-expired sends the user back into the login they just
        # completed, which on a 429 only extends the block.
        return emit({"ok": False, "error": _classify(e, default="auth-expired"),
                     "detail": type(e).__name__})
    finally:
        if TOKENS_PATH.exists():
            _secure_tokens()
    return emit({"ok": True, "tokens": str(TOKENS_PATH)})

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
