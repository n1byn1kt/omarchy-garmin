#!/usr/bin/env python3
"""garmin-widget — Garmin Connect helper for the io.github.n1byn1kt.garmin Omarchy plugin.

Contract: every subcommand prints exactly one JSON object to stdout and
exits 0. Errors are data: {"ok": false, "error": "<category>"} with
category in: deps | no-tokens | auth-expired | offline | api-error.
"""
import datetime
import json
import os
import sys
import tempfile
from pathlib import Path

def _home() -> Path:
    return Path(os.environ.get("HOME", str(Path.home())))

# Recomputed at import so tests can swap $HOME per-test via load_helper().
TOKENS_PATH = _home() / ".config" / "garmin-widget" / "tokens.json"
CACHE_PATH = _home() / ".cache" / "garmin-widget" / "last.json"

try:
    import garminconnect  # noqa: F401
    HAS_GARMINCONNECT = True
except Exception:
    HAS_GARMINCONNECT = False

def emit(obj) -> int:
    print(json.dumps(obj))
    return 0

def cmd_status() -> int:
    return emit({"ok": True, "deps": HAS_GARMINCONNECT, "tokens": TOKENS_PATH.exists()})

DEPS_HINT = ("python3 -m venv ~/.local/share/garmin-widget/venv && "
             "~/.local/share/garmin-widget/venv/bin/pip install garminconnect")

def _venv_python() -> Path:
    return _home() / ".local" / "share" / "garmin-widget" / "venv" / "bin" / "python"

def _maybe_reexec_into_venv(argv) -> None:
    """Arch (and other PEP 668 distros) block pip into system python.

    If garminconnect isn't importable in the current interpreter but a
    dedicated venv exists, re-exec this same script under the venv's
    python. GARMIN_WIDGET_REEXEC guards against looping if the venv is
    somehow also missing garminconnect.
    """
    if HAS_GARMINCONNECT or "GARMIN_WIDGET_REEXEC" in os.environ:
        return
    venv_py = _venv_python()
    if not venv_py.exists():
        return
    os.environ["GARMIN_WIDGET_REEXEC"] = "1"
    try:
        os.execv(str(venv_py), [str(venv_py), os.path.abspath(__file__), *argv])
    except OSError:
        # Broken venv (bad perms/shebang, partial install, ENOENT race):
        # fall through to normal dispatch, which will report the deps
        # payload rather than crash before printing any JSON at all.
        pass

def main(argv) -> int:
    _maybe_reexec_into_venv(argv)
    cmd = argv[0] if argv else "fetch"
    if cmd == "status":
        return cmd_status()
    if cmd == "fetch":
        return cmd_fetch()
    if cmd == "login":
        return cmd_login()
    return emit({"ok": False, "error": "api-error", "detail": f"unknown command {cmd!r}"})

def _get(d, *keys):
    for k in keys:
        d = d.get(k) if isinstance(d, dict) else None
    return d

def build_payload(summary, sleep, as_of):
    dto = _get(sleep, "dailySleepDTO") or {}
    secs = dto.get("sleepTimeSeconds")
    return {
        "ok": True, "stale": False, "asOf": as_of,
        "bodyBattery": {
            "current": summary.get("bodyBatteryMostRecentValue"),
            "high": summary.get("bodyBatteryHighestValue"),
            "low": summary.get("bodyBatteryLowestValue"),
        },
        "sleep": {
            "score": _get(dto, "sleepScores", "overall", "value"),
            "durationMin": round(secs / 60) if secs else None,
        },
        "steps": {"count": summary.get("totalSteps"),
                  "goal": summary.get("dailyStepGoal")},
        "restingHr": summary.get("restingHeartRate"),
    }

def _load_cache():
    try:
        return json.loads(CACHE_PATH.read_text())
    except Exception:
        return None

def cmd_fetch() -> int:
    if not HAS_GARMINCONNECT:
        return emit({"ok": False, "error": "deps",
                     "hint": DEPS_HINT})
    if not TOKENS_PATH.exists():
        return emit({"ok": False, "error": "no-tokens",
                     "hint": "run: garmin-widget login"})
    import garminconnect as gc
    today = datetime.date.today().isoformat()
    now = datetime.datetime.now().isoformat(timespec="minutes")
    try:
        g = gc.Garmin()
        g.login(tokenstore=str(TOKENS_PATH))
        payload = build_payload(g.get_user_summary(today) or {},
                                g.get_sleep_data(today) or {}, now)
    except gc.GarminConnectAuthenticationError:
        return emit({"ok": False, "error": "auth-expired",
                     "hint": "run: garmin-widget login"})
    except Exception as e:
        cached = _load_cache()
        if cached is not None:
            cached["stale"] = True
            return emit(cached)
        offline = (isinstance(e, (ConnectionError, OSError, TimeoutError))
                   or "Connection" in type(e).__name__)
        return emit({"ok": False,
                     "error": "offline" if offline else "api-error",
                     "detail": str(e)[:200]})
    _write_cache(payload)
    return emit(payload)

def _write_cache(payload) -> None:
    """Replace the cache atomically, or not at all.

    A torn write is worse than a missing cache: the next offline fetch would
    read half a JSON object, fall through to the generic error branch, and the
    bar would blank instead of showing yesterday's numbers. Writing a sibling
    temp file and os.replace()ing it means readers only ever see a whole file.
    Still best-effort overall — a full or read-only disk must not break fetch.
    """
    tmp = None
    try:
        CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=str(CACHE_PATH.parent),
                                   prefix=".last-", suffix=".json")
        with os.fdopen(fd, "w") as fh:
            json.dump(payload, fh)
        os.replace(tmp, CACHE_PATH)  # same directory, so this is atomic
        tmp = None
    except Exception:
        pass  # cache write is best-effort; must never break fetch
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except Exception:
                pass

def cmd_login() -> int:
    if not HAS_GARMINCONNECT:
        return emit({"ok": False, "error": "deps",
                     "hint": DEPS_HINT})
    import getpass
    import garminconnect as gc
    # Interactive prompts go to stderr so stdout stays JSON-only.
    print("Garmin Connect login (credentials go to Garmin only, "
          "tokens stay local).", file=sys.stderr)
    print("Email: ", end="", file=sys.stderr, flush=True)
    email = input()
    password = getpass.getpass("Password: ")

    def _prompt_mfa():
        print("MFA code: ", end="", file=sys.stderr, flush=True)
        return input()

    try:
        g = gc.Garmin(email=email, password=password,
                      prompt_mfa=_prompt_mfa)
        g.login()
        TOKENS_PATH.parent.mkdir(parents=True, exist_ok=True)
        g.client.dump(str(TOKENS_PATH))
        TOKENS_PATH.chmod(0o600)
    except Exception as e:
        return emit({"ok": False, "error": "auth-expired",
                     "detail": str(e)[:200]})
    return emit({"ok": True, "tokens": str(TOKENS_PATH)})

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
